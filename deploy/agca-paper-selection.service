[Unit]
Description=AGCA independent minute PAPER selection and learning cycle
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=kursadsalis
Group=kursadsalis
WorkingDirectory=/home/kursadsalis/AG-Crypto-Analyst-cloud
EnvironmentFile=-/etc/agca/agca.env
EnvironmentFile=-/etc/agca/remote-database.env
Environment=PYTHONUNBUFFERED=1
Environment=AGCA_EXECUTION_MODE=PAPER_ONLY
Environment=AGCA_REMOTE_MIRROR_INLINE=0
ExecStart=/home/kursadsalis/AG-Crypto-Analyst-cloud/.venv/bin/python -m runtime.paper_selection_cycle
# Three bounded SPOT evidence captures can legitimately exceed 50 seconds on
# the Supabase PostgreSQL egress route. systemd still serializes timer starts.
TimeoutStartSec=120
UMask=0077
Nice=5
