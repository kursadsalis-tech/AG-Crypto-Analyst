[Unit]
Description=AGCA continuous Binance technical kline collector
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=kursadsalis
Group=kursadsalis
WorkingDirectory=/home/kursadsalis/AG-Crypto-Analyst-cloud
EnvironmentFile=-/etc/agca/agca.env
Environment=PYTHONUNBUFFERED=1
Environment=AGCA_EXECUTION_MODE=PAPER_ONLY
Environment=AGCA_DATABASE_PATH=/var/lib/agca/crypto_data.db
Environment=AGCA_REMOTE_MIRROR_INLINE=0
Environment=AGCA_BINANCE_WS_OPEN_TIMEOUT_SECONDS=10
ExecStart=/home/kursadsalis/AG-Crypto-Analyst-cloud/.venv/bin/python -m runtime.technical_kline_worker
Restart=always
RestartSec=5
TimeoutStopSec=20
Nice=10
MemoryMax=256M
CPUQuota=40%
UMask=0077

[Install]
WantedBy=multi-user.target
