[Unit]
Description=AGCA background trade learning specialist
Wants=network-online.target
After=network-online.target

StartLimitIntervalSec=300
StartLimitBurst=4

[Service]
Type=simple
User=kursadsalis
Group=kursadsalis
WorkingDirectory=/home/kursadsalis/AG-Crypto-Analyst-cloud
EnvironmentFile=-/etc/agca/agca.env
Environment=PYTHONUNBUFFERED=1
Environment=AGCA_EXECUTION_MODE=PAPER_ONLY
Environment=AGCA_DATABASE_PATH=/var/lib/agca/crypto_data.db
Environment=AGCA_REMOTE_MIRROR_INLINE=0
Environment=AGCA_TRADE_LEARNING_INTERVAL_SECONDS=60
Environment=AGCA_TRADE_LEARNING_RETRY_SECONDS=20
ExecStart=/home/kursadsalis/AG-Crypto-Analyst-cloud/.venv/bin/python -m runtime.trade_learning_worker
Restart=always
RestartSec=30
TimeoutStopSec=20
Nice=15
MemoryMax=384M
CPUQuota=50%
UMask=0077

[Install]
WantedBy=multi-user.target
