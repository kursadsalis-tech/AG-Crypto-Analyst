[Unit]
Description=AGCA public OKX copy-trader full-cohort collector
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=kursadsalis
Group=kursadsalis
WorkingDirectory=/home/kursadsalis/AG-Crypto-Analyst-cloud
EnvironmentFile=-/etc/agca/agca.env
Environment=PYTHONUNBUFFERED=1
Environment=AGCA_EXECUTION_MODE=PAPER_ONLY
Environment=AGCA_REMOTE_MIRROR_INLINE=0
ExecStart=/home/kursadsalis/AG-Crypto-Analyst-cloud/.venv/bin/python -m data.okx_copy_trader_collector
TimeoutStartSec=600
UMask=0077
Nice=10

[Install]
WantedBy=multi-user.target
