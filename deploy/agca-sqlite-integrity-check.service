[Unit]
Description=AGCA independent low-priority SQLite full integrity check
After=network-online.target

[Service]
Type=oneshot
User=kursadsalis
Group=kursadsalis
WorkingDirectory=/home/kursadsalis/AG-Crypto-Analyst-cloud
Environment=AGCA_SQLITE_INTEGRITY_CACHE_PATH=/var/lib/agca/sqlite-integrity-health.json
ExecStart=/home/kursadsalis/AG-Crypto-Analyst-cloud/.venv/bin/python -m runtime.sqlite_integrity_check
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=45min
UMask=0077
