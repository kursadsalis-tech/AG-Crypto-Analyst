[Unit]
Description=AGCA unattended cloud runtime attestation
After=network-online.target agca-paper-realtime-worker.service
Wants=network-online.target

[Service]
Type=oneshot
User=kursadsalis
Group=kursadsalis
WorkingDirectory=/home/kursadsalis/AG-Crypto-Analyst-cloud
EnvironmentFile=-/etc/agca/agca.env
EnvironmentFile=-/etc/agca/remote-database.env
Environment=HOME=/home/kursadsalis
Environment=AGCA_EXECUTION_MODE=PAPER_ONLY
Environment=AGCA_WORKER_SERVICE=agca-paper-realtime-worker.service
Environment=AGCA_ATTESTATION_HEALTH_MAX_AGE_SECONDS=900
Environment=AGCA_MARKET_BEHAVIOR_HEALTH_MAX_AGE_SECONDS=180
Environment=AGCA_EXACT_MACRO_HEALTH_MAX_AGE_SECONDS=180
Environment=AGCA_REMOTE_MIRROR_INLINE=0
Environment=AGCA_ATTESTATION_USE_INTEGRITY_CACHE=1
Environment=AGCA_SQLITE_INTEGRITY_MAX_AGE_SECONDS=90000
ExecStart=/home/kursadsalis/AG-Crypto-Analyst-cloud/.venv/bin/python -m runtime.cloud_attestation
UMask=0077
