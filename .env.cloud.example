# Copy values into /etc/agca/agca.env on the Ubuntu VM.
# Never commit the real file or expose its contents in terminal output.

AGCA_REMOTE_DATABASE_URL=postgresql://postgres:replace-me@db.example.supabase.co:5432/postgres?sslmode=require
AGCA_REMOTE_DATABASE_SCHEMA=agca_runtime
AGCA_REMOTE_CONNECT_TIMEOUT_SECONDS=5
AGCA_REMOTE_RETRY_SECONDS=60

# Telegram/other secrets already used by AGCA may be added on the VM using
# their existing environment variable names. Do not place them in Git.
