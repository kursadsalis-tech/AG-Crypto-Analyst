# Local SQLite remains the authoritative runtime store.
# Set this URL to enable best-effort dual-write to PostgreSQL/Supabase.
AGCA_REMOTE_DATABASE_URL=postgresql://postgres:replace-me@db.example.supabase.co:5432/postgres?sslmode=require

# Optional settings (defaults shown).
AGCA_REMOTE_DATABASE_SCHEMA=agca_runtime
AGCA_REMOTE_CONNECT_TIMEOUT_SECONDS=5
AGCA_REMOTE_STATEMENT_TIMEOUT_MS=30000
AGCA_REMOTE_LOCK_TIMEOUT_MS=5000
AGCA_REMOTE_TCP_USER_TIMEOUT_MS=30000
AGCA_REMOTE_BATCH_SIZE=100
AGCA_REMOTE_MIRROR_INLINE=0
AGCA_REMOTE_RETRY_SECONDS=60

# Cloud worker: PAPER_ONLY is a hard safety gate. Mount AGCA_STATE_DIR on a
# persistent volume and place crypto_data.db there (or symlink it into /app).
AGCA_EXECUTION_MODE=PAPER_ONLY
AGCA_STATE_DIR=/var/lib/agca
AGCA_BINANCE_SPOT_BASE_URL=https://data-api.binance.vision

# Explicit simulated venue semantics. SHORT requires USD_M_PERPETUAL.
AGCA_PAPER_MARKET=USD_M_PERPETUAL
AGCA_PAPER_TAKER_FEE_BPS=5
AGCA_PAPER_SPREAD_BPS=4
AGCA_PAPER_SLIPPAGE_BPS=3
AGCA_PAPER_LATENCY_BPS=1
AGCA_PAPER_FUNDING_BPS_8H=1
AGCA_PAPER_MAX_VOLUME_PARTICIPATION=0.01
